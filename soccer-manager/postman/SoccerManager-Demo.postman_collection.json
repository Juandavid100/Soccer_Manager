            "acudientes",
            "{{acudienteDemo}}"
          ]
        },
        "description": "Regla de negocio en AcudienteService.eliminar (líneas 73-75)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 409 porque tiene estudiantes a cargo', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
